# Do not place real secrets in the repository or image.
# 4YI injects installation scope; local development requires a trusted SSO proxy.
SHANNON_AUTH_MODE=4yi_sso
XCLAW_APP_HOSTNAME=
XCLAW_CONSUMER_ORG_ID=
POSTGRES_PASSWORD=
# Supplied by the 4YI per-install gateway runtime:
OPENAI_API_BASE=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-6
TEMPORAL_ADDRESS=shannon-temporal:7233
DATA_DIR=/app/data
SHANNON_EXECUTION_ENABLED=false
SHANNON_EGRESS_POLICY_VERIFIED=false
# Exact authorized origins, comma-separated; no wildcard and no path:
SHANNON_AUTHORIZED_ORIGINS=
